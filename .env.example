# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Supabase > Project Settings > API (ou "Connect" no topo do dashboard)

# URL do projeto, ex.: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable, começa com sb_publishable_...) — OU a chave "anon" legada.
# NUNCA coloque a chave secreta/service_role aqui (ela vai só na variável de baixo).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOMENTE NO SEU COMPUTADOR: é com ela que o painel (sem usuário e senha) funciona
# no `npm run dev`. Chave "secret" (sb_secret_...) ou "service_role". É secreta: não
# compartilhe, não envie ao GitHub e NÃO cadastre na Vercel (lá o /admin não existe).
SUPABASE_SECRET_KEY=

# Endereço público do site (sem barra no final). Usado no sitemap, SEO e Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
